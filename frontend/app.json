{
  "expo": {
    "name": "OpenBook Library",
    "slug": "openbook-library",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openbook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.openbooklibrary.xiz91c"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#171717"
      },
      "package": "com.emergent.openbooklibrary.xiz91c"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "OpenBook Library",
      "shortName": "OpenBook",
      "themeColor": "#F3F0E9",
      "backgroundColor": "#F3F0E9",
      "description": "Discover Stories. Explore Knowledge. Read Without Boundaries."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F0E9"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/feather"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}